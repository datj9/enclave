# enclave — environment. Copy to .env and edit. Every variable here is validated by
# src/env.ts at startup; the process exits non-zero and names the offender if one is wrong.
#
# The values below are DEVELOPMENT DEFAULTS, not secrets. Replace every one of them before
# exposing this instance to anything. Generate the two secrets with:
#   openssl rand -base64 48

# --- app -----------------------------------------------------------------------------------
APP_URL=http://localhost:3000
# Must contain the {id} placeholder. One browser origin per artifact (grill-result §4.1).
ARTIFACT_ORIGIN_TEMPLATE=http://{id}.artifacts.localhost:3000

# --- database ------------------------------------------------------------------------------
# Host-side URL. Postgres is published on 5434 because 5432 and 5433 are commonly taken.
# The app container overrides this with the compose-internal host (see docker-compose.yml).
DATABASE_URL=postgresql://enclave:enclave@localhost:5434/enclave

# --- object storage (S3-compatible: AWS S3, GCS, R2, B2, MinIO) ----------------------------
# Defaults target the optional `minio` compose profile: docker compose --profile minio up -d
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=enclave-artifacts
S3_ACCESS_KEY_ID=enclave-dev-access-key
S3_SECRET_ACCESS_KEY=enclave-dev-secret-key
# MinIO needs path-style addressing; set false for AWS S3.
S3_FORCE_PATH_STYLE=true
# Only when using the bundled `minio` compose profile. S3_ENDPOINT above is the host-side value
# that tests and drizzle use; the app *container* has to reach MinIO by its service name. Leave
# this unset when S3_ENDPOINT already points at real S3, R2 or B2.
S3_ENDPOINT_INTERNAL=http://minio:9000
# The endpoint a browser must use for presigned asset URLs. With the bundled MinIO the app reaches
# storage at minio:9000 but the viewer resolves localhost:9000, and a presigned URL signs its host.
# Leave unset for real S3, R2 or B2, where one endpoint serves both.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- secrets (both must be at least 32 bytes) ----------------------------------------------
SESSION_SECRET=dev-only-session-secret-replace-me-before-deploying
ENCRYPTION_KEY=dev-only-encryption-key-replace-me-before-deploying

# --- LLM providers -------------------------------------------------------------------------
# At least one provider key is needed to generate; the app boots without them.
# ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
DEFAULT_MODEL=claude-sonnet-4-6

# --- registration --------------------------------------------------------------------------
# true means anyone who can reach /signup becomes a member, and "visible to the
# organization" then means visible to anyone who signs up.
ALLOW_OPEN_REGISTRATION=false

# --- optional OIDC -------------------------------------------------------------------------
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# --- rate limits and quotas ----------------------------------------------------------------
RATE_LIMIT_GENERATIONS_PER_HOUR=10
QUOTA_GENERATIONS_PER_DAY=100
QUOTA_GENERATIONS_PER_DAY_OWN_KEY=1000
# Must be at least QUOTA_GENERATIONS_PER_DAY_OWN_KEY / 24 or the daily own-key quota above is unreachable.
RATE_LIMIT_GENERATIONS_PER_HOUR_OWN_KEY=100
# Per-IP cap on sign-in and setup attempts.
RATE_LIMIT_AUTH_PER_IP_PER_HOUR=30

# --- bundle limits -------------------------------------------------------------------------
BUNDLE_MAX_FILES=50
BUNDLE_MAX_TOTAL_BYTES=10485760
BUNDLE_MAX_FILE_BYTES=2097152

# --- token lifetimes (seconds) -------------------------------------------------------------
PRESIGN_TTL_SECONDS=60
HANDOFF_TTL_SECONDS=30
ARTIFACT_GRANT_TTL_SECONDS=1800

# --- retention (days) ----------------------------------------------------------------------
TRASH_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
